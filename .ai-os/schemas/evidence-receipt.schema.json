{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://personal-ai-os.local/schemas/evidence-receipt.schema.json",
  "title": "Personal AI OS Evidence Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "receipt_id", "task_id", "project", "summary", "behavioral_evidence",
    "verification", "review", "integration", "risk", "rollback", "cost",
    "remaining_uncertainty"
  ],
  "properties": {
    "receipt_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "project": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1},
    "what_changed": {"type": "array", "items": {"type": "string"}},
    "what_did_not_change": {"type": "array", "items": {"type": "string"}},
    "behavioral_evidence": {"type": "array", "items": {"type": "string"}},
    "visual_evidence": {"type": "array", "items": {"type": "string"}},
    "architecture_impact": {"type": "string"},
    "reuse_impact": {"type": "string"},
    "data_impact": {"type": "string"},
    "security_privacy": {"type": "string"},
    "performance": {"type": "string"},
    "verification": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "result"],
        "properties": {
          "command": {"type": "string"},
          "result": {"enum": ["pass", "fail", "inconclusive", "not_applicable"]},
          "evidence_path": {"type": ["string", "null"]},
          "notes": {"type": "string"}
        }
      }
    },
    "review": {"enum": ["pass", "block", "not_required"]},
    "integration": {"enum": ["pass", "block", "not_required"]},
    "risk": {"enum": ["R0", "R1", "R2", "R3"]},
    "rollback": {"type": "string"},
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wall_clock_minutes", "external_usd", "builder_attempts"],
      "properties": {
        "wall_clock_minutes": {"type": "number", "minimum": 0},
        "external_usd": {"type": "number", "minimum": 0},
        "ci_minutes": {"type": "number", "minimum": 0},
        "builder_attempts": {"type": "integer", "minimum": 0}
      }
    },
    "remaining_uncertainty": {"type": "array", "items": {"type": "string"}},
    "user_decisions": {"type": "array", "items": {"type": "string"}}
  }
}
