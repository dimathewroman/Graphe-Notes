{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://personal-ai-os.local/schemas/cleanup-receipt-v1.schema.json",
  "title": "Personal AI OS Cleanup Receipt V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "cleanup_id", "plan_id", "orchestration_run_id",
    "task_id", "unit_id", "visible_task_id", "archived_visible_task_ids",
    "integration_evidence", "final_handoff", "archive", "worktree",
    "inventory", "recorded_at"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "cleanup_id": {"type": "string", "minLength": 1},
    "plan_id": {"type": "string", "minLength": 1},
    "orchestration_run_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "unit_id": {"type": "string", "minLength": 1},
    "visible_task_id": {"type": "string", "minLength": 1},
    "archived_visible_task_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "integration_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_reference", "verified_at"],
      "properties": {
        "evidence_reference": {"type": "string", "minLength": 1},
        "verified_at": {"type": "string", "format": "date-time"}
      }
    },
    "final_handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_reference", "recorded_at"],
      "properties": {
        "evidence_reference": {"type": "string", "minLength": 1},
        "recorded_at": {"type": "string", "format": "date-time"}
      }
    },
    "archive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence_reference", "archived_at"],
      "properties": {
        "status": {"const": "archived"},
        "evidence_reference": {"type": "string", "minLength": 1},
        "archived_at": {"type": "string", "format": "date-time"}
      }
    },
    "worktree": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "branch", "head_commit", "recoverable_ref", "removed_at"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "branch": {"type": "string", "minLength": 1},
        "head_commit": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
        "recoverable_ref": {"type": "string", "minLength": 1},
        "removed_at": {"type": "string", "format": "date-time"}
      }
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["git_worktrees", "codex_open_tasks"],
      "properties": {
        "git_worktrees": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "evidence_reference", "observed_at", "registered_paths"],
          "properties": {
            "source": {"const": "git_worktree_list"},
            "evidence_reference": {"type": "string", "minLength": 1},
            "observed_at": {"type": "string", "format": "date-time"},
            "registered_paths": {
              "type": "array",
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            }
          }
        },
        "codex_open_tasks": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source", "evidence_reference", "observed_at", "open_task_ids",
            "current_coordinator_task_id", "current_coordinator_intentionally_open"
          ],
          "properties": {
            "source": {"const": "codex_open_task_inventory"},
            "evidence_reference": {"type": "string", "minLength": 1},
            "observed_at": {"type": "string", "format": "date-time"},
            "open_task_ids": {
              "type": "array",
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            },
            "current_coordinator_task_id": {"type": ["string", "null"], "minLength": 1},
            "current_coordinator_intentionally_open": {"type": "boolean"}
          }
        }
      }
    },
    "recorded_at": {"type": "string", "format": "date-time"}
  }
}
