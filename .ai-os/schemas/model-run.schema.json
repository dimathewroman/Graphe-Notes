{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://personal-ai-os.local/schemas/model-run.schema.json",
  "title": "Personal AI OS Model Run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id", "orchestration_run_id", "task_id", "role", "task_class",
    "provider", "model", "effort", "started_at", "finished_at",
    "input_tokens", "output_tokens", "cached_tokens", "estimated_cost_usd",
    "actual_cost_usd", "wall_clock_seconds", "first_pass", "result", "failure_category",
    "review_status", "integration_status", "notes"
  ],
  "properties": {
    "run_id": {"type": "string", "minLength": 1},
    "orchestration_run_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "role": {"type": "string", "minLength": 1},
    "task_class": {"type": "string"},
    "provider": {"type": "string", "minLength": 1},
    "model": {"type": "string", "minLength": 1},
    "effort": {"type": ["string", "null"]},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "input_tokens": {"type": ["integer", "null"], "minimum": 0},
    "output_tokens": {"type": ["integer", "null"], "minimum": 0},
    "cached_tokens": {"type": ["integer", "null"], "minimum": 0},
    "estimated_cost_usd": {"type": ["number", "null"], "minimum": 0},
    "actual_cost_usd": {"type": ["number", "null"], "minimum": 0},
    "wall_clock_seconds": {"type": "number", "minimum": 0},
    "first_pass": {"type": "boolean"},
    "result": {"enum": ["pass", "fail", "blocked", "cancelled"]},
    "failure_category": {"enum": [null, "implementation", "requirements", "architecture", "ux", "security", "integration", "environment", "harness", "timeout", "cost_limit", "other"]},
    "review_status": {"type": ["string", "null"]},
    "integration_status": {"type": ["string", "null"]},
    "notes": {"type": "string"}
  }
}
