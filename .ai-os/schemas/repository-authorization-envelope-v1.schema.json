{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://personal-ai-os.local/schemas/repository-authorization-envelope-v1.schema.json",
  "title": "Personal AI OS Repository Authorization Envelope V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "envelope_id", "task_packet_v1_id",
    "task_packet_v1_digest", "repository", "allowed_effects",
    "prohibited_effects", "read_grants", "git_permissions", "issuer"
  ],
  "properties": {
    "schema_version": {"enum": [1]},
    "envelope_id": {"type": "string", "minLength": 1},
    "task_packet_v1_id": {"type": "string", "minLength": 1},
    "task_packet_v1_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_id", "root", "remote", "allowed_worktree_roots"],
      "properties": {
        "repository_id": {"type": "string", "minLength": 1},
        "root": {"type": "string", "minLength": 1},
        "remote": {"type": ["string", "null"]},
        "allowed_worktree_roots": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "allowed_effects": {
      "type": "array",
      "items": {"enum": ["observe", "propose", "reversible_write", "external_write", "destructive"]}
    },
    "prohibited_effects": {
      "type": "array",
      "items": {"enum": ["observe", "propose", "reversible_write", "external_write", "destructive"]}
    },
    "read_grants": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["grant_id", "resource", "operation", "purpose", "data_class", "derived_content", "expires_at"],
        "properties": {
          "grant_id": {"type": "string", "minLength": 1},
          "resource": {"type": "string", "minLength": 1},
          "operation": {"enum": ["read"]},
          "purpose": {"type": "string", "minLength": 1},
          "data_class": {"enum": ["public", "internal", "confidential", "restricted"]},
          "derived_content": {"enum": ["none", "sanitized", "repository_allowed"]},
          "expires_at": {"type": ["string", "null"], "format": "date-time"}
        }
      }
    },
    "git_permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["endpoints", "operations"],
      "properties": {
        "endpoints": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "operations": {
          "type": "array",
          "items": {"enum": ["local_commit", "push_branch", "create_draft_pr", "update_issue", "merge", "tag_release"]}
        }
      }
    },
    "issuer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "principal_id", "principal_kind", "authority_source",
        "authorization_grant_id", "authorization_grant_digest",
        "authentication_method", "proof_reference", "issued_at",
        "expires_at", "revocation_reference"
      ],
      "properties": {
        "principal_id": {"type": "string", "minLength": 1},
        "principal_kind": {"enum": ["owner", "enrolled_runtime", "enrolled_device"]},
        "authority_source": {"enum": ["owner_message", "enrolled_runtime_grant", "device_enrollment"]},
        "authorization_grant_id": {"type": "string", "minLength": 1},
        "authorization_grant_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "authentication_method": {"type": "string", "minLength": 1},
        "proof_reference": {"type": "string", "minLength": 1},
        "issued_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": ["string", "null"], "format": "date-time"},
        "revocation_reference": {"type": ["string", "null"]}
      }
    }
  }
}
