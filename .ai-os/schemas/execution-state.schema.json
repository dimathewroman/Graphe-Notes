{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://personal-ai-os.local/schemas/execution-state.schema.json",
  "title": "Personal AI OS Execution State",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_id", "orchestration_run_id", "task_id", "created_at", "updated_at", "units"],
  "properties": {
    "schema_version": {"enum": [1]},
    "plan_id": {"type": "string", "minLength": 1},
    "orchestration_run_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "units": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["unit_id", "status", "assignment", "head_commit", "review_count", "last_review_verdict", "history"],
        "properties": {
          "unit_id": {"type": "string", "minLength": 1},
          "status": {"enum": ["planned", "assigned", "running", "blocked", "ready_for_review", "review_blocked", "approved", "escalation_required", "cancelled"]},
          "assignment": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": ["executor_task_id", "executor_identity", "worktree_path", "branch", "base_commit", "provider", "model", "effort", "assigned_at"],
            "properties": {
              "executor_task_id": {"type": "string", "minLength": 1},
              "executor_identity": {"type": "string", "minLength": 1},
              "worktree_path": {"type": "string", "minLength": 1},
              "branch": {"type": "string", "minLength": 1},
              "base_commit": {"type": "string", "minLength": 1},
              "provider": {"type": "string", "minLength": 1},
              "model": {"type": "string", "minLength": 1},
              "effort": {"type": ["string", "null"]},
              "assigned_at": {"type": "string", "format": "date-time"}
            }
          },
          "head_commit": {"type": ["string", "null"]},
          "review_count": {"type": "integer", "minimum": 0},
          "last_review_verdict": {"enum": [null, "PASS", "BLOCK"]},
          "history": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["status", "at", "summary"],
              "properties": {
                "status": {"enum": ["planned", "assigned", "running", "blocked", "ready_for_review", "review_blocked", "approved", "escalation_required", "cancelled"]},
                "at": {"type": "string", "format": "date-time"},
                "summary": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    }
  }
}
