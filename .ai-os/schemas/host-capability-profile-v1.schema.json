{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://personal-ai-os.local/schemas/host-capability-profile-v1.schema.json",
  "title": "Personal AI OS Host Capability Profile V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "profile_id", "host_identity", "operating_system",
    "architecture", "status", "resources", "connectivity", "lanes",
    "constraints", "verified_at", "evidence"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "profile_id": {"type": "string", "minLength": 1},
    "host_identity": {"type": "string", "minLength": 1},
    "operating_system": {"enum": ["macos", "windows", "linux"]},
    "architecture": {"type": "string", "minLength": 1},
    "status": {"enum": ["observed", "eligible", "enrolled", "active", "retired"]},
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["memory_gib", "cpu_threads", "storage_free_gib", "gpu"],
      "properties": {
        "memory_gib": {"type": "number", "exclusiveMinimum": 0},
        "cpu_threads": {"type": "integer", "minimum": 1},
        "storage_free_gib": {"type": ["number", "null"], "minimum": 0},
        "gpu": {"type": ["string", "null"]}
      }
    },
    "connectivity": {
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["local", "tailscale", "teamviewer_recovery"]}
    },
    "lanes": {
      "type": "array",
      "minItems": 1,
      "x-paios-unique-by": "kind",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "status", "max_parallel", "constraints"],
        "properties": {
          "kind": {
            "enum": [
              "control_plane", "portable_build", "android_build",
              "android_emulator", "apple_build", "apple_simulator",
              "web_browser", "windows_desktop", "linux_service"
            ]
          },
          "status": {"enum": ["available", "eligible", "requires_setup", "unsupported"]},
          "max_parallel": {"type": ["integer", "null"], "minimum": 1},
          "constraints": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "constraints": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "verified_at": {"type": "string", "format": "date-time"},
    "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
