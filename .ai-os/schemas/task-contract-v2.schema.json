{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://personal-ai-os.local/schemas/task-contract-v2.schema.json",
  "title": "Personal AI OS Task Contract V2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "contract_id", "task_packet_v1",
    "authorization_envelope_v1", "task_class", "risk_tier", "budgets",
    "checkpoints", "roles", "skills", "review", "privacy_class",
    "retention_class"
  ],
  "properties": {
    "schema_version": {"enum": [2]},
    "contract_id": {"type": "string", "minLength": 1},
    "task_packet_v1": {
      "type": "object", "additionalProperties": false,
      "required": ["task_id", "digest"],
      "properties": {
        "task_id": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "authorization_envelope_v1": {
      "type": "object", "additionalProperties": false,
      "required": ["envelope_id", "digest"],
      "properties": {
        "envelope_id": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "task_class": {"type": "string", "minLength": 1},
    "risk_tier": {"enum": ["R0", "R1", "R2", "R3"]},
    "budgets": {
      "type": "object", "additionalProperties": false,
      "required": ["max_wall_clock_minutes", "max_external_cost_usd", "max_actions"],
      "properties": {
        "max_wall_clock_minutes": {"type": "number", "minimum": 0},
        "max_external_cost_usd": {"type": "number", "minimum": 0},
        "max_actions": {"type": "integer", "minimum": 1}
      }
    },
    "checkpoints": {
      "type": "object", "additionalProperties": false,
      "required": ["max_actions_per_advance", "max_wait_seconds"],
      "properties": {
        "max_actions_per_advance": {"type": "integer", "minimum": 1},
        "max_wait_seconds": {"type": "integer", "minimum": 0}
      }
    },
    "roles": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "skills": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "review": {
      "type": "object", "additionalProperties": false,
      "required": ["required", "reviewer_role", "repair_limit"],
      "properties": {
        "required": {"type": "boolean"},
        "reviewer_role": {"type": ["string", "null"]},
        "repair_limit": {"type": "integer", "minimum": 0}
      }
    },
    "privacy_class": {"enum": ["public", "internal", "confidential", "restricted"]},
    "retention_class": {"enum": ["ephemeral", "detailed_90_days", "aggregate_12_months", "decision_evidence"]}
  }
}
