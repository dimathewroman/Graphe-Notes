{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://personal-ai-os.local/schemas/database-architecture-profile-v1.schema.json",
  "title": "Personal AI OS Database Architecture Profile V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_id", "project_id", "adoption_status", "profile_depth", "deployment_shapes", "offline", "data_domains", "stores", "workload_overlays", "benchmarks", "owner_gates", "recheck_triggers", "evidence"],
  "properties": {
    "schema_version": {"const": 1},
    "profile_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "adoption_status": {"enum": ["template", "advisory_not_adopted", "project_adopted"]},
    "profile_depth": {"enum": ["lightweight", "full"]},
    "deployment_shapes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["device_local", "owner_hosted", "managed_cloud"]}},
    "offline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["support", "data_availability", "sync_strategy", "conflict_contract"],
      "properties": {
        "support": {"enum": ["offline_capable", "connected_only", "not_applicable"]},
        "data_availability": {"type": "string", "minLength": 1},
        "sync_strategy": {"type": ["string", "null"]},
        "conflict_contract": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["unit", "detection", "resolution", "user_visibility"],
          "properties": {
            "unit": {"type": "string", "minLength": 1},
            "detection": {"type": "string", "minLength": 1},
            "resolution": {"type": "string", "minLength": 1},
            "user_visibility": {"type": "string", "minLength": 1}
          }
        }
      },
      "allOf": [
        {"if": {"properties": {"support": {"const": "offline_capable"}}}, "then": {"properties": {"sync_strategy": {"type": "string", "minLength": 1}, "conflict_contract": {"type": "object"}}}}
      ]
    },
    "data_domains": {
      "type": "array", "minItems": 1, "x-paios-unique-by": "domain_id",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["domain_id", "description", "consequence", "authority_store_id"],
        "properties": {
          "domain_id": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "consequence": {"enum": ["consequential", "replaceable"]},
          "authority_store_id": {"type": "string", "minLength": 1},
          "portable_export": {
            "type": "object", "additionalProperties": false,
            "required": ["logical_format", "schema_version", "round_trip_test"],
            "properties": {"logical_format": {"type": "string", "minLength": 1}, "schema_version": {"type": "string", "minLength": 1}, "round_trip_test": {"type": "string", "minLength": 1}}
          },
          "recovery": {
            "type": "object", "additionalProperties": false,
            "required": ["backup", "restore_test", "target"],
            "properties": {"backup": {"type": "string", "minLength": 1}, "restore_test": {"type": "string", "minLength": 1}, "target": {"type": "string", "minLength": 1}}
          }
        },
        "allOf": [
          {"if": {"properties": {"consequence": {"const": "consequential"}}}, "then": {"required": ["portable_export", "recovery"]}}
        ]
      }
    },
    "stores": {
      "type": "array", "minItems": 1, "x-paios-unique-by": "store_id",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["store_id", "engine_family", "role", "storage_class", "specialization_basis", "deployment_shapes", "data_domain_ids", "version_conformance", "derived_contract"],
        "properties": {
          "store_id": {"type": "string", "minLength": 1},
          "engine_family": {"type": "string", "minLength": 1},
          "role": {"enum": ["authoritative", "derived"]},
          "storage_class": {"enum": ["standard_sql", "object_store", "specialized_search", "specialized_vector", "specialized_graph", "specialized_olap", "specialized_event_log"]},
          "specialization_basis": {"enum": ["standard_default", "measured_need", "owner_directed_experiment"]},
          "deployment_shapes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["device_local", "owner_hosted", "managed_cloud"]}},
          "data_domain_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "version_conformance": {"type": "string", "minLength": 1},
          "derived_contract": {
            "type": ["object", "null"], "additionalProperties": false,
            "required": ["authority_store_ids", "rebuild", "freshness", "deletion_propagation", "fallback"],
            "properties": {
              "authority_store_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
              "rebuild": {"type": "string", "minLength": 1},
              "freshness": {"type": "string", "minLength": 1},
              "deletion_propagation": {"type": "string", "minLength": 1},
              "fallback": {"type": "string", "minLength": 1}
            }
          }
        },
        "allOf": [
          {"if": {"properties": {"role": {"const": "derived"}}}, "then": {"properties": {"derived_contract": {"type": "object"}}}},
          {"if": {"properties": {"role": {"const": "authoritative"}}}, "then": {"properties": {"derived_contract": {"type": "null"}}}},
          {"if": {"properties": {"storage_class": {"const": "specialized_search"}}}, "then": {"properties": {"specialization_basis": {"enum": ["measured_need", "owner_directed_experiment"]}}}},
          {"if": {"properties": {"storage_class": {"const": "specialized_vector"}}}, "then": {"properties": {"specialization_basis": {"enum": ["measured_need", "owner_directed_experiment"]}}}},
          {"if": {"properties": {"storage_class": {"const": "specialized_graph"}}}, "then": {"properties": {"specialization_basis": {"enum": ["measured_need", "owner_directed_experiment"]}}}},
          {"if": {"properties": {"storage_class": {"const": "specialized_olap"}}}, "then": {"properties": {"specialization_basis": {"enum": ["measured_need", "owner_directed_experiment"]}}}},
          {"if": {"properties": {"storage_class": {"const": "specialized_event_log"}}}, "then": {"properties": {"specialization_basis": {"enum": ["measured_need", "owner_directed_experiment"]}}}}
        ]
      }
    },
    "workload_overlays": {
      "type": "array", "minItems": 1, "x-paios-unique-by": "overlay_id",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["overlay_id", "kind", "requirements", "test_obligations"],
        "properties": {
          "overlay_id": {"type": "string", "minLength": 1},
          "kind": {"enum": ["general", "financial_ledger", "geospatial_catalog", "collaborative_document", "agent_memory"]},
          "requirements": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "test_obligations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "benchmarks": {
      "type": "array", "minItems": 1, "x-paios-unique-by": "benchmark_id",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["benchmark_id", "status", "target", "measurement", "spike", "recheck_trigger"],
        "properties": {
          "benchmark_id": {"type": "string", "minLength": 1},
          "status": {"enum": ["measured", "estimated", "unknown"]},
          "target": {"type": "string", "minLength": 1},
          "measurement": {"type": ["string", "null"]},
          "spike": {
            "type": ["object", "null"], "additionalProperties": false,
            "required": ["question", "timebox", "acceptance"],
            "properties": {"question": {"type": "string", "minLength": 1}, "timebox": {"type": "string", "minLength": 1}, "acceptance": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}
          },
          "recheck_trigger": {"type": ["string", "null"]}
        },
        "allOf": [
          {"if": {"properties": {"status": {"const": "unknown"}}}, "then": {"properties": {"spike": {"type": "object"}, "recheck_trigger": {"type": "string", "minLength": 1}}}}
        ]
      }
    },
    "owner_gates": {"type": "array", "uniqueItems": true, "items": {"enum": ["new_external_production_service", "recurring_spend", "private_data_upload", "network_exposure", "second_authoritative_store", "destructive_migration", "lock_in_without_export"]}},
    "recheck_triggers": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
