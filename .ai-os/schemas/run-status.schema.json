{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://personal-ai-os.local/schemas/run-status.schema.json",
  "title": "Personal AI OS Run Status",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "run_id", "task_id", "status",
    "created_at", "updated_at", "history"
  ],
  "properties": {
    "schema_version": {"enum": [1]},
    "run_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["draft", "ready", "building", "review", "integration", "blocked", "done", "cancelled"]},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "at", "summary"],
        "properties": {
          "status": {"enum": ["draft", "ready", "building", "review", "integration", "blocked", "done", "cancelled"]},
          "at": {"type": "string", "format": "date-time"},
          "summary": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
