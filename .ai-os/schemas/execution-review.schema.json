{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://personal-ai-os.local/schemas/execution-review.schema.json",
  "title": "Personal AI OS Execution Review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "review_id", "review_number", "plan_id",
    "orchestration_run_id", "task_id", "unit_id", "reviewer_task_id",
    "reviewer_identity", "provider", "model", "effort", "frozen_head",
    "verdict", "findings", "summary", "reviewed_at", "unit_status", "independent"
  ],
  "properties": {
    "schema_version": {"enum": [1]},
    "review_id": {"type": "string", "minLength": 1},
    "review_number": {"type": "integer", "minimum": 1},
    "plan_id": {"type": "string", "minLength": 1},
    "orchestration_run_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "unit_id": {"type": "string", "minLength": 1},
    "reviewer_task_id": {"type": "string", "minLength": 1},
    "reviewer_identity": {"type": "string", "minLength": 1},
    "provider": {"type": "string", "minLength": 1},
    "model": {"type": "string", "minLength": 1},
    "effort": {"type": ["string", "null"]},
    "frozen_head": {"type": "string", "minLength": 1},
    "verdict": {"enum": ["PASS", "BLOCK"]},
    "findings": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "summary": {"type": "string", "minLength": 1},
    "reviewed_at": {"type": "string", "format": "date-time"},
    "unit_status": {"enum": ["approved", "review_blocked", "escalation_required"]},
    "independent": {"enum": [true]}
  }
}
