{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://personal-ai-os.local/schemas/prior-art-survey-v1.schema.json",
  "title": "Personal AI OS Prior-Art Survey V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "survey_id", "project_id", "scope", "trigger", "status", "reviewed_at", "sources", "candidates", "claims", "decision_summary", "recheck_triggers"],
  "properties": {
    "schema_version": {"const": 1},
    "survey_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "scope": {"type": "string", "minLength": 1},
    "trigger": {"enum": ["project_start", "major_subsystem", "pain_or_change", "monthly_review", "owner_request"]},
    "status": {"enum": ["draft", "decision_ready", "accepted", "superseded"]},
    "reviewed_at": {"type": "string", "format": "date-time"},
    "sources": {
      "type": "array", "minItems": 1, "x-paios-unique-by": "source_id",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["source_id", "source_type", "title", "locator", "selected_because", "checked_at", "revision", "license"],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "source_type": {"enum": ["official_docs", "source_repository", "package_registry", "standard", "paper", "adoption_report", "community_report", "owner_supplied_data", "local_observation", "search_index"]},
          "title": {"type": "string", "minLength": 1},
          "locator": {"type": "string", "minLength": 1},
          "selected_because": {"type": "string", "minLength": 1},
          "checked_at": {"type": "string", "format": "date-time"},
          "revision": {"type": ["string", "null"]},
          "license": {"type": ["string", "null"]}
        }
      }
    },
    "candidates": {
      "type": "array", "minItems": 1, "x-paios-unique-by": "candidate_id",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["candidate_id", "name", "proposed_use", "source_ids", "benefits", "risks", "limitations", "usage_evidence", "disposition", "rationale", "deeper_dive"],
        "properties": {
          "candidate_id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "proposed_use": {"type": "string", "minLength": 1},
          "source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "benefits": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "risks": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "usage_evidence": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "disposition": {"enum": ["study", "adopt", "fork", "extend", "learn_and_rebuild", "build_new", "defer", "reject"]},
          "rationale": {"type": "string", "minLength": 1},
          "deeper_dive": {"enum": ["none", "proposed", "owner_approval_required", "approved", "completed"]}
        }
      }
    },
    "claims": {
      "type": "array", "minItems": 1, "x-paios-unique-by": "claim_id",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["claim_id", "statement", "claim_class", "source_ids", "inference_basis", "uncertainty"],
        "properties": {
          "claim_id": {"type": "string", "minLength": 1},
          "statement": {"type": "string", "minLength": 1},
          "claim_class": {"enum": ["verified_fact", "observed_behavior", "reported_evidence", "interpretation", "inference", "hypothesis", "unknown"]},
          "source_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "inference_basis": {"type": ["string", "null"]},
          "uncertainty": {"type": ["string", "null"]}
        }
      }
    },
    "decision_summary": {
      "type": "object", "additionalProperties": false,
      "required": ["recommendation", "alternatives", "source_mix_rationale", "evidence_gaps", "owner_decision_required"],
      "properties": {
        "recommendation": {"type": "string", "minLength": 1},
        "alternatives": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "source_mix_rationale": {"type": "string", "minLength": 1},
        "evidence_gaps": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "owner_decision_required": {"type": "boolean"}
      }
    },
    "recheck_triggers": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
