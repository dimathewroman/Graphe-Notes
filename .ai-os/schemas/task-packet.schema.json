{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://personal-ai-os.local/schemas/task-packet.schema.json",
  "title": "Personal AI OS Task Packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id", "project", "title", "outcome", "risk_tier", "status",
    "scope", "non_goals", "acceptance_criteria", "ownership",
    "context_sources", "skills", "verification", "evidence", "approvals", "budget"
  ],
  "properties": {
    "task_id": {"type": "string", "minLength": 1},
    "project": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "outcome": {"type": "string", "minLength": 1},
    "task_class": {"type": "string"},
    "risk_tier": {"enum": ["R0", "R1", "R2", "R3"]},
    "status": {"enum": ["draft", "ready", "building", "review", "integration", "blocked", "done", "cancelled"]},
    "scope": {"type": "array", "items": {"type": "string"}},
    "non_goals": {"type": "array", "items": {"type": "string"}},
    "requirements": {"type": "array", "items": {"type": "string"}},
    "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "reuse_candidates": {"type": "array", "items": {"type": "string"}},
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owns", "may_modify", "must_not_modify"],
      "properties": {
        "owns": {"type": "array", "items": {"type": "string"}},
        "may_modify": {"type": "array", "items": {"type": "string"}},
        "must_not_modify": {"type": "array", "items": {"type": "string"}}
      }
    },
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "contracts": {"type": "array", "items": {"type": "string"}},
    "context_sources": {"type": "array", "items": {"type": "string"}},
    "skills": {"type": "array", "items": {"type": "string"}},
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commands", "fixtures", "devices"],
      "properties": {
        "commands": {"type": "array", "items": {"type": "string"}},
        "fixtures": {"type": "array", "items": {"type": "string"}},
        "devices": {"type": "array", "items": {"type": "string"}},
        "performance_budgets": {"type": "array", "items": {"type": "string"}}
      }
    },
    "evidence": {"type": "array", "items": {"type": "string"}},
    "approvals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent_may_decide", "user_must_decide", "merge_authority"],
      "properties": {
        "agent_may_decide": {"type": "array", "items": {"type": "string"}},
        "user_must_decide": {"type": "array", "items": {"type": "string"}},
        "merge_authority": {"type": "string"}
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_wall_clock_minutes", "max_external_cost_usd", "max_builder_attempts"],
      "properties": {
        "max_wall_clock_minutes": {"type": "number", "minimum": 0},
        "max_external_cost_usd": {"type": "number", "minimum": 0},
        "max_ci_minutes": {"type": "number", "minimum": 0},
        "max_builder_attempts": {"type": "integer", "minimum": 1}
      }
    },
    "agent_judgment": {"type": "array", "items": {"type": "string"}}
  }
}
