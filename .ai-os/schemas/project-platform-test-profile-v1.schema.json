{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://personal-ai-os.local/schemas/project-platform-test-profile-v1.schema.json",
  "title": "Personal AI OS Project Platform and Test Profile V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "profile_id", "project_id", "portability_default",
    "shared_core", "ui_strategy", "targets", "test_layers", "tool_spikes",
    "quality_attributes", "recheck_triggers"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "profile_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "portability_default": {"enum": ["cross_platform_ready", "single_platform_deliberate"]},
    "shared_core": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domains", "platform_seams", "portable_fixtures"],
      "properties": {
        "domains": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "platform_seams": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "portable_fixtures": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "ui_strategy": {"enum": ["undecided_spike_required", "native_per_platform", "shared_ui", "hybrid"]},
    "targets": {
      "type": "array",
      "minItems": 1,
      "x-paios-unique-by": "platform",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["platform", "status", "experience", "build_host_profiles", "acceptance_lanes"],
        "properties": {
          "platform": {"enum": ["android", "ios", "ipados", "macos", "windows", "linux", "web", "server"]},
          "status": {"enum": ["primary", "planned", "conditional", "not_applicable"]},
          "experience": {"enum": ["native_quality", "platform_adapted", "consistent_shared", "not_applicable"]},
          "build_host_profiles": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "acceptance_lanes": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "test_layers": {
      "type": "array",
      "minItems": 1,
      "x-paios-unique-by": "layer",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["layer", "required_when", "host_profiles", "fidelity", "budget"],
        "properties": {
          "layer": {"type": "string", "minLength": 1},
          "required_when": {"type": "string", "minLength": 1},
          "host_profiles": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "fidelity": {"enum": ["static", "host", "emulated", "simulated", "physical", "production_like"]},
          "budget": {"type": "string", "minLength": 1}
        }
      }
    },
    "tool_spikes": {
      "type": "array",
      "x-paios-unique-by": "candidate",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidate", "question", "timebox", "acceptance", "status"],
        "properties": {
          "candidate": {"type": "string", "minLength": 1},
          "question": {"type": "string", "minLength": 1},
          "timebox": {"type": "string", "minLength": 1},
          "acceptance": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "status": {"enum": ["proposed", "approved", "running", "accepted", "rejected", "deferred"]}
        }
      }
    },
    "quality_attributes": {
      "type": "array",
      "minItems": 1,
      "items": {"enum": ["correctness", "native_feel", "accessibility", "smoothness", "performance", "reliability", "debuggability", "portability", "cost", "delivery_speed"]}
    },
    "recheck_triggers": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
